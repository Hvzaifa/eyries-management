# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe for the browser, enforces RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string used by Prisma (pooled connection; port 6543 if using pooler)
DATABASE_URL=

# Direct (non-pooled) Postgres connection — required for migrations/schema changes (port 5432)
DIRECT_URL=

# Daily deadline alert job (Step 7)
# Bearer token Vercel Cron sends to /api/cron/deadline-check — any long random string.
CRON_SECRET=
# Resend API key for sending the alert email (resend.com/dashboard/api-keys)
RESEND_API_KEY=
# Verified sender, e.g. "Eyries Alerts <alerts@yourdomain.com>"
ALERT_FROM_EMAIL=
# Comma-separated staff recipients, e.g. ops@company.com,manager@company.com
STAFF_ALERT_EMAILS=
# Public URL of the app (used in email links), e.g. https://eyries.vercel.app
NEXT_PUBLIC_APP_URL=


# Google AI Studio key for the AI intake (paste / screenshot parsing). Reached
# through Gemini's OpenAI-compatible endpoint, so the key must be a Gemini key —
# a key from another provider will 401, whatever the variable is called.
GEMINI_API_KEY=
# Optional: pins one model instead of gemini-3.5-flash-lite -> gemini-3.5-flash.
GEMINI_MODEL=
# Free Groq key (console.groq.com): the backup provider when Gemini is busy or
# out of quota. Optional, but without it the intake has one provider only.
GROQ_API_KEY=
# Optional: pins the Groq model (default qwen/qwen3.8-27b).
GROQ_MODEL=
